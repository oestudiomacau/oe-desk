# Select one provider: ollama or openai. DeepSeek uses openai-compatible mode.
RAG_PROVIDER=openai
PORT=3000

# Local Ollama. Install a chat model and an embedding model before starting.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI or any OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=deepseek-chat
RAG_EMBEDDING_ENABLED=false

# Optional web-search fallback. It only runs when the local knowledge base has no match.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=4
